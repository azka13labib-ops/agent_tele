# ==========================================
# Hermes Telegram Bot - Environment Template
# ==========================================

# 1. Telegram Bot Token (Dapatkan dari @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# 2. AI Provider (Token Harbor, 9Router, OpenRouter, atau endpoint OpenAI lainnya)
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=your_api_key_here
AI_MODEL=agent_tele

# 3. Security: Whitelist Telegram ID Pemilik (Dapatkan ID dari @userinfobot)
# Pisahkan dengan koma jika lebih dari 1 ID (contoh: 12345678,87654321)
OWNER_ID=your_telegram_user_id_here

# 4. Hybrid Remote Worker (Opsional, jika bot dijalankan di server dan laptop jadi worker)
# REMOTE_WORKER_URL=http://100.x.y.z:20130
# WORKER_SECRET=hermes-tailscale-secret
