# ==========================================
# Konfigurasi Hermes Bot di Server (Template)
# ==========================================

# 1. Telegram Bot Token (Dapatkan dari @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# 2. 9Router AI Gateway (Mengarah ke IP Tailscale Laptop Utama)
AI_BASE_URL=http://<LAPTOP_TAILSCALE_IP>:20128/v1
NINEROUTER_API_KEY=your_9router_api_key_here
AI_MODEL=agent_tele

# 3. Keamanan: Whitelist Telegram ID Pemilik
OWNER_ID=your_telegram_user_id_here

# 4. Bridge ke Laptop Worker (Untuk eksekusi GPU & file lokal di laptop)
REMOTE_WORKER_URL=http://<LAPTOP_TAILSCALE_IP>:20130
WORKER_SECRET=hermes-tailscale-secret
